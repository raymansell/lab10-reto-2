# Token de evaluación del equipo: la test suite lo envía a la réplica.
# Configurar el valor real como secreto de la plataforma al desplegar.
# El token de exploración del original no se configura en este servicio.
REPLICA_TOKEN=replace-with-the-evaluation-token
PORT=3000
# En producción, configurar HOST=0.0.0.0 como variable de la plataforma.
HOST=127.0.0.1
