{
  "name": "caja-negra-replica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.mjs",
    "test": "node --test test/*.test.mjs",
    "test:regression": "node scripts/regression.mjs",
    "dev:cloudflare": "wrangler dev",
    "deploy:cloudflare": "wrangler deploy",
    "secret:cloudflare": "node --env-file-if-exists=.env scripts/cloudflare-secret.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261006.1-alpha",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.29.1",
    "ws": "8.21.0"
  }
}
